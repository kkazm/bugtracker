### Sign up
< {%
    request.variables.set("username", "user")
    request.variables.set("password", "pass")
%}
POST {{host}}/signup
Content-Type: application/json

{
  "firstName": "Konrad",
  "lastName": "Kowalski",
  "username": "{{username}}",
  "password": "{{password}}"
}
> {%
    client.global.set("auth_token", response.body.token)
%}

### Login
POST {{host}}/login
Content-Type: application/json

{
  "username": "user",
  "password": "pass"
}
> {%
    client.global.set("auth_token", response.body.token)
%}

### Get a page of Users
GET {{host}}/users?page=0&size=10
Authorization: Bearer {{auth_token}}

### Create a Project
POST {{host}}/projects
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "projectName": "Example project 8"
}

### Get a Page of Projects
GET {{host}}/projects?page=0&size=20
Authorization: Bearer {{auth_token}}

### Get a Project by ID
< {%
    request.variables.set("project_id", "1")
%}
GET {{host}}/projects/{{project_id}}
Authorization: Bearer {{auth_token}}

### Delete a Project by ID
DELETE {{host}}/projects/1
Authorization: Bearer {{auth_token}}

### Create an Issue
POST {{host}}/issues
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "title": "My first issue",
  "projectId": 2,
  "description": "Something is wrong"
}

### Get a page of Issues belonging to a Project
< {%
    request.variables.set("projectId", 0)
%}
GET {{host}}/projects/{{projectId}}/issues?page=0&size=20&sort=id,desc
Authorization: Bearer {{auth_token}}

### Get an Issue by ID
< {%
    request.variables.set("issue_id", 3)
%}
GET {{host}}/issues/{{issue_id}}
Authorization: Bearer {{auth_token}}

### Delete an Issue by ID
< {%
    request.variables.set("id", "2")
%}
DELETE {{host}}/issues/{{id}}
Authorization: Bearer {{auth_token}}
